# ============================================================
#  BOB — omgevingsvariabelen
#
#  Lokaal: kopieer dit naar .env.local
#  Vercel: zet dezelfde variabelen bij Settings ->
#          Environment Variables. Nooit in de repo.
#
#  Alleen NEXT_PUBLIC_* komt in de browser terecht. Al het andere
#  blijft op de server.
# ============================================================

# --- Site -----------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://jouw-bob.vercel.app

# --- Toegang --------------------------------------------------
# Waarmee je sessiecookie wordt ondertekend. Minstens 32 tekens,
# willekeurig. Maken:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Verander je hem, dan is iedereen meteen uitgelogd. Dat is je noodrem.
BOB_SESSION_SECRET=

# Wie er binnen mag. Eén adres is genoeg; meerdere met komma's.
# Staat een adres hier niet, dan komt het er ook met een geldige
# inloglink niet in.
BOB_ALLOWED_EMAILS=jij@voorbeeld.nl

# Noodingang zolang er nog geen mailer staat: één lange geheime code.
# Minstens 20 tekens, anders wordt hij genegeerd. Haal hem weg zodra
# de mail werkt.
BOB_LOGIN_CODE=

# Hoe lang je ingelogd blijft.
BOB_SESSION_DAYS=30

# --- Xano (de database) ---------------------------------------
# app.xano.com. Alleen tabellen — alle logica staat in deze website,
# zodat je op één plek kunt kijken als er iets niet klopt.
# Het token maak je bij Account -> Metadata API, met de scopes
# "Workspace Content: Read/Write" en "Workspace Database: Read/Write".
XANO_INSTANCE_URL=https://xxxx-xxxx-xxxx.n7.xano.io
XANO_METADATA_TOKEN=
XANO_WORKSPACE_ID=

# De tabel-ID's. Die krijg je van:  npm run xano
XANO_TABLE_OAUTH_TOKENS=
XANO_TABLE_BERICHTEN=
XANO_TABLE_INSTELLINGEN=
XANO_TABLE_BRIDGE_TOKENS=

# --- Mail (om de inloglink te versturen) ----------------------
# Eén van de twee is genoeg. Resend is het snelst opgezet.
RESEND_API_KEY=
SENDGRID_API_KEY=
BOB_MAIL_FROM=BOB <onboarding@resend.dev>

# --- Claude (het brein) ---------------------------------------
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
## Alleen voor preview: activeert AI zonder overige koppelingen aan te zetten.
BOB_PREVIEW_ANTHROPIC_API_KEY=
BOB_PREVIEW_ANTHROPIC_MODEL=claude-sonnet-5
# Google multi-account in Preview, met aparte versleuteling (32 random bytes in hex).
BOB_PREVIEW_GOOGLE_CLIENT_ID=
BOB_PREVIEW_GOOGLE_CLIENT_SECRET=
BOB_ACCOUNT_ENCRYPTION_KEY=
# DATABASE_URL wordt door Neon via Vercel ingesteld.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Cartesia (stem) ------------------------------------------
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_VERSION=2026-08-14
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_LANGUAGE=nl

# --- Todoist --------------------------------------------------
TODOIST_API_TOKEN=

# --- Google (Agenda + Gmail, alleen lezen) --------------------
# console.cloud.google.com -> Credentials -> OAuth client (Web)
# Redirect URI: https://jouw-bob.vercel.app/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft (Outlook) --------------------------------------
# entra.microsoft.com -> App registrations
# Redirect URI: https://jouw-bob.vercel.app/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Zoeken ---------------------------------------------------
# api-dashboard.search.brave.com
BRAVE_API_KEY=
BRAVE_COUNTRY=NL
BRAVE_LANG=nl

# --- Social (optioneel) ---------------------------------------
LINKEDIN_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Via Vercel Marketplace: Upstash Redis (alleen server-side)
KV_REST_API_URL=
KV_REST_API_TOKEN=
