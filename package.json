{
  "name": "bob-web",
  "version": "2.0.0",
  "private": true,
  "description": "BOB — Sanders persoonlijke assistent, als privéwebsite.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bridge": "node bridge/agent.mjs",
    "env": "node scripts/env-doctor.mjs",
    "xano": "node scripts/xano-tabellen.mjs",
    "test": "node --import tsx tests/test-sessie.ts && node --import tsx tests/test-foundation.ts && node --import tsx --test tests/regressions.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "ipaddr.js": "^2.5.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.25",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
